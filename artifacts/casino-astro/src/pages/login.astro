---
import BaseLayout from "@/layouts/BaseLayout.astro";

const returnTo = Astro.url.searchParams.get("returnTo") || "/";
---

<BaseLayout
  title="Log In — Charter & Oak"
  description="Log in to your Charter & Oak Casino account."
>
  <section class="relative min-h-[85vh] flex flex-col items-center justify-center overflow-hidden">
    {/* Amber lamplight */}
    <div class="absolute inset-0 amber-lamp"></div>
    {/* Felt surface */}
    <div class="absolute inset-0 felt-surface opacity-25"></div>

    <div class="container mx-auto px-4 z-10 flex flex-col items-center">
      <div class="w-full max-w-md flex flex-col gap-8 rounded-xl bg-card border border-border shadow-lg p-8 md:p-10">
        {/* Brand mark */}
        <div class="flex flex-col items-center gap-3">
          <span class="text-xl caslon tracking-tight text-primary">Charter &amp; Oak</span>
          <div class="h-px w-12 bg-primary/30"></div>
        </div>

        <div class="flex flex-col gap-2 text-center">
          <h1 class="text-3xl text-foreground">Welcome Back</h1>
          <p class="text-muted-foreground text-sm">
            Log in to your account to continue playing.
          </p>
        </div>

        <a
          href={`/api/login?returnTo=${encodeURIComponent(returnTo)}`}
          class="btn btn-primary w-full text-base py-3 amber-glow-sm"
        >
          Log In
        </a>

        <p class="text-sm text-muted-foreground text-center">
          Don't have an account?
          <a
            href={`/signup?returnTo=${encodeURIComponent(returnTo)}`}
            class="text-primary hover:underline ml-1">Sign up</a
          >
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
