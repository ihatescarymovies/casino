---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Transactions from "@/components/islands/Transactions.tsx";
import { IslandErrorBoundary } from "@/components/IslandErrorBoundary.tsx";
---

<BaseLayout title="Transaction History — Charter & Oak" description="View your deposits, withdrawals, bets, wins, and bonuses.">
  <div class="container mx-auto max-w-5xl px-4 pt-8"><a class="text-sm text-primary hover:underline" href="/fairness">Public fairness verifier →</a></div>
  <IslandErrorBoundary client:load>
    <Transactions client:load />
