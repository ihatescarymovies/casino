---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GamesFilter from "@/components/islands/GamesFilter.tsx";
import { IslandErrorBoundary } from "@/components/IslandErrorBoundary.tsx";
import QueryProvider from "@/components/islands/QueryProvider.tsx";
import { apiFetch } from "@/lib/api";
import type { Game } from "@workspace/api-client-react";

type Category = { name: string; count: number };

const [categories, games] = await Promise.all([
  apiFetch<Category[]>("/api/games/categories"),
  apiFetch<Game[]>("/api/games"),
]);
---

<BaseLayout title="Casino Lobby — Charter & Oak" description="Browse our full collection of slots, table games, and live dealer experiences.">
  <main id="main-content" class="container mx-auto px-4 py-12 flex flex-col gap-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-white/10 pb-8">
      <div>
        <h1 class="text-4xl font-bold text-white mb-2 tracking-tight">Casino Lobby</h1>
        <p class="text-muted-foreground text-lg">Find your next big win from our selection of premium games.</p>
      </div>
    </div>

    <IslandErrorBoundary client:idle>
      <QueryProvider client:idle>
        <GamesFilter client:idle categories={categories ?? []} games={games ?? []} />
      </QueryProvider>
    </IslandErrorBoundary>
  </main>
</BaseLayout>
