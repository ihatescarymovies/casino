---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GameCard from "@/components/GameCard.astro";
import QueryProvider from "@/components/islands/QueryProvider.tsx";
import JackpotCounter from "@/components/islands/JackpotCounter.tsx";
import WinnersTicker from "@/components/islands/WinnersTicker.tsx";
import { IslandErrorBoundary } from "@/components/IslandErrorBoundary.tsx";
import { apiFetch } from "@/lib/api";
import { formatCurrency } from "@/lib/formatters";
import type { Game } from "@workspace/api-client-react";

type Winner = {
  id: number;
  playerName: string;
  gameName: string;
  winAmount: number;
};

type CasinoStats = {
  totalPayoutToday: number;
  activePlayers: number;
  gamesAvailable: number;
  currentJackpot: number;
};

const featuredGames = await apiFetch<Game[]>("/api/games/featured");
const winners = await apiFetch<Winner[]>("/api/winners?limit=10");
const stats = await apiFetch<CasinoStats>("/api/stats");
---

<BaseLayout>
  <div class="flex flex-col w-full">
    <section class="relative min-h-[80vh] flex flex-col items-center justify-center overflow-hidden border-b border-white/10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(220,38,38,0.15),transparent_70%)]" />
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20 mix-blend-overlay pointer-events-none" />

      <div class="container mx-auto px-4 z-10 flex flex-col items-center text-center mt-12 mb-8">
        <div class="inline-flex items-center rounded-full bg-red-500/20 text-red-500 border border-red-500/50 px-4 py-1.5 backdrop-blur-md mb-6">
          <span class="relative flex h-2 w-2 mr-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
          </span>
          LIVE PROGRESSIVE JACKPOT
        </div>

        <div class="mb-8">
          <IslandErrorBoundary client:load>
            <QueryProvider client:load>
              <JackpotCounter client:load initialAmount={stats?.currentJackpot} />
            </QueryProvider>
          </IslandErrorBoundary>
        </div>

        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 max-w-3xl tracking-tight leading-tight">
          Ohio's High-Roller Experience
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mb-10">
          Step into the VIP lounge. Premium games, massive payouts, and non-stop action.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a href="/games" class="btn btn-primary text-lg px-8 h-14 w-full sm:w-auto shadow-[0_0_20px_rgba(234,179,8,0.4)]">
            Play Now
          </a>
          <a href="/games" class="btn btn-secondary text-lg px-8 h-14 w-full sm:w-auto">
            Explore Games
          </a>
        </div>
      </div>

      <div class="w-full mt-auto bg-background/50 backdrop-blur-xl border-t border-white/10 py-6">
        <div class="container mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="flex flex-col items-center text-center">
            <span class="text-sm text-muted-foreground uppercase tracking-wider mb-1">Total Payout Today</span>
            <span class="text-2xl font-bold text-white">
              {stats ? formatCurrency(stats.totalPayoutToday) : "—"}
            </span>
          </div>
          <div class="flex flex-col items-center text-center">
            <span class="text-sm text-muted-foreground uppercase tracking-wider mb-1">Active Players</span>
            <span class="text-2xl font-bold text-white">
              {stats ? stats.activePlayers.toLocaleString() : "—"}
            </span>
          </div>
          <div class="flex flex-col items-center text-center">
            <span class="text-sm text-muted-foreground uppercase tracking-wider mb-1">Games Available</span>
            <span class="text-2xl font-bold text-white">
              {stats ? stats.gamesAvailable.toLocaleString() : "—"}
            </span>
          </div>
          <div class="flex flex-col items-center text-center">
            <span class="text-sm text-muted-foreground uppercase tracking-wider mb-1">Win Rate</span>
            <span class="text-2xl font-bold text-primary">97.8%</span>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-card border-b border-white/5 overflow-hidden flex items-center h-12">
      <div class="bg-primary/10 text-primary px-4 h-full flex items-center font-bold whitespace-nowrap z-10 border-r border-primary/20">
        RECENT WINS
      </div>
      <div class="flex-1 overflow-hidden relative">
        <div class="absolute top-0 left-0 w-8 h-full bg-gradient-to-r from-card to-transparent z-10" />
        <div class="absolute top-0 right-0 w-8 h-full bg-gradient-to-l from-card to-transparent z-10" />
        <IslandErrorBoundary client:load>
          <QueryProvider client:load>
            <WinnersTicker client:load winners={winners ?? []} />
          </QueryProvider>
        </IslandErrorBoundary>
      </div>
    </div>

    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="flex items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl font-bold text-white mb-2">Featured Games</h2>
            <p class="text-muted-foreground">Hand-picked for high rollers.</p>
          </div>
          <a href="/games" class="text-primary hover:text-primary/80 font-medium hidden sm:block">
            View All Games &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {featuredGames && featuredGames.length > 0 ? (
            featuredGames.map((game) => (
              <GameCard
                id={game.id}
                name={game.name}
                category={game.category}
                provider={game.provider}
                imageUrl={game.imageUrl}
                isFeatured={game.isFeatured}
                isHot={game.isHot}
                isNew={game.isNew}
              />
            ))
          ) : (
            <div class="col-span-full py-12 text-center text-muted-foreground">No games found.</div>
          )}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/games" class="btn btn-secondary w-full">View All Games</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
