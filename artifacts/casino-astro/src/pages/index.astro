---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GameCard from "@/components/GameCard.astro";
import JackpotIsland from "@/components/islands/JackpotIsland.tsx";
import WinnersIsland from "@/components/islands/WinnersIsland.tsx";
import { apiFetch } from "@/lib/api";
import { formatCurrency } from "@/lib/formatters";
import type { Game } from "@workspace/api-client-react";

type Winner = {
  id: number;
  playerName: string;
  gameName: string;
  winAmount: number;
};

type CasinoStats = {
  totalPayoutToday: number;
  activePlayers: number;
  gamesAvailable: number;
  currentJackpot: number;
};

const [featuredGames, winners, stats] = await Promise.all([
  apiFetch<Game[]>("/api/games/featured"),
  apiFetch<Winner[]>("/api/winners?limit=10"),
  apiFetch<CasinoStats>("/api/stats"),
]);
---

<BaseLayout>
  <div class="flex flex-col w-full">
    <!-- HERO: The gaming table under lamplight -->
    <section class="relative min-h-[85vh] flex flex-col items-center justify-center overflow-hidden">
      {/* Amber lamplight — the pool of light from a table lamp */}
      <div class="absolute inset-0 amber-lamp"></div>

      {/* Felt surface — the gaming table itself */}
      <div class="absolute inset-0 felt-surface opacity-30"></div>

      <div class="container mx-auto px-4 z-10 flex flex-col items-center text-center mt-16 mb-10">
        {/* Live jackpot indicator — brass pill, not red alert */}
        <div class="inline-flex items-center rounded-full bg-primary/10 text-primary border border-primary/30 px-4 py-1.5 mb-8">
          <span class="relative flex h-2 w-2 mr-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/60 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          <span class="text-xs font-semibold tracking-wide uppercase">Live Progressive Jackpot</span>
        </div>

        {/* Jackpot display — seven-segment amber */}
        <div class="mb-10">
          <noscript>
            <div class="data-display text-5xl md:text-7xl lg:text-8xl animate-amber-pulse">
              {stats ? formatCurrency(stats.currentJackpot) : "—"}
            </div>
          </noscript>
          <JackpotIsland client:load initialAmount={stats?.currentJackpot} />
        </div>

        <h1 class="text-4xl md:text-6xl text-foreground mb-6 max-w-3xl leading-tight">
          Ohio's High-Roller Experience
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mb-10">
          Step into the VIP lounge. Premium games, massive payouts, and non-stop action.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a href="/games" class="btn btn-primary text-lg px-8 h-14 w-full sm:w-auto amber-glow-md">
            Play Now
          </a>
          <a href="/games" class="btn btn-secondary text-lg px-8 h-14 w-full sm:w-auto">
            Explore Games
          </a>
        </div>
      </div>

      {/* Stats bar — seven-segment readouts at the table's edge */}
      <div class="w-full mt-auto bg-card/80 brass-rail-top py-6">
        <div class="container mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="flex flex-col items-center text-center">
            <span class="text-xs text-muted-foreground uppercase tracking-wider mb-2">Total Payout Today</span>
            <span class="data-display text-2xl">
              {stats ? formatCurrency(stats.totalPayoutToday) : "—"}
            </span>
          </div>
          <div class="flex flex-col items-center text-center">
            <span class="text-xs text-muted-foreground uppercase tracking-wider mb-2">Active Players</span>
            <span class="data-display text-2xl">
              {stats ? stats.activePlayers.toLocaleString() : "—"}
            </span>
          </div>
          <div class="flex flex-col items-center text-center">
            <span class="text-xs text-muted-foreground uppercase tracking-wider mb-2">Games Available</span>
            <span class="data-display text-2xl">
              {stats ? stats.gamesAvailable.toLocaleString() : "—"}
            </span>
          </div>
          <div class="flex flex-col items-center text-center">
            <span class="text-xs text-muted-foreground uppercase tracking-wider mb-2">Win Rate</span>
            <span class="data-display text-2xl">97.8%</span>
          </div>
        </div>
      </div>
    </section>

    {/* Winners ticker — felt strip with marquee */}
    <div class="bg-card border-b border-border overflow-hidden flex items-center h-12">
      <div class="bg-primary/10 text-primary px-4 h-full flex items-center font-semibold whitespace-nowrap z-10 border-r border-primary/20 text-sm uppercase tracking-wide">
        Recent Wins
      </div>
      <div class="flex-1 overflow-hidden relative">
        <div class="absolute top-0 left-0 w-8 h-full bg-gradient-to-r from-card to-transparent z-10"></div>
        <div class="absolute top-0 right-0 w-8 h-full bg-gradient-to-l from-card to-transparent z-10"></div>
        <noscript>
          <div class="flex items-center gap-4 animate-marquee whitespace-nowrap px-4 text-sm">
            {winners?.map((w) => (
              <span class="text-muted-foreground">
                <strong class="text-primary">{w.playerName}</strong> won {formatCurrency(w.winAmount)} on {w.gameName}
              </span>
            )) ?? <span class="text-muted-foreground">No recent wins</span>}
          </div>
        </noscript>
        <WinnersIsland client:load winners={winners ?? []} />
      </div>
    </div>

    {/* Featured Games — cards on the felt */}
    <section class="py-20">
      <div class="container mx-auto px-4">
        <div class="flex items-end justify-between mb-12">
          <div>
            <h2 class="text-3xl text-foreground mb-2">Featured Games</h2>
            <p class="text-muted-foreground">Hand-picked for high rollers.</p>
          </div>
          <a href="/games" class="text-primary hover:text-primary-hover font-medium hidden sm:block transition-colors">
            View All Games &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {featuredGames && featuredGames.length > 0 ? (
            featuredGames.map((game) => (
              <GameCard
                id={game.id}
                name={game.name}
                category={game.category}
                provider={game.provider}
                imageUrl={game.imageUrl}
                isFeatured={game.isFeatured}
                isHot={game.isHot}
                isNew={game.isNew}
              />
            ))
          ) : (
            <div class="col-span-full py-12 text-center text-muted-foreground">No games found.</div>
          )}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/games" class="btn btn-secondary w-full">View All Games</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
