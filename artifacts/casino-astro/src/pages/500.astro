---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Server Error — Charter & Oak" description="Something went wrong. Our team has been notified.">
  <main id="main-content" class="container mx-auto px-4 py-24 flex flex-col items-center justify-center text-center">
    <div class="max-w-md">
      <div class="h-20 w-20 mx-auto mb-8 rounded-full bg-destructive/10 border border-destructive/20 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-destructive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
      </div>
      <h1 class="text-3xl text-foreground mb-3">Something Went Wrong</h1>
      <p class="text-muted-foreground mb-8 leading-relaxed">
        We hit an unexpected error. Our team has been notified and is working on a fix.
        Please try again in a few moments.
      </p>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
  </main>
</BaseLayout>
