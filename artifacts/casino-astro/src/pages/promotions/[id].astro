---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiFetch } from "@/lib/api";
import { isPromotionExpired } from "@/lib/promotion-helpers";

const { id } = Astro.params;
const promoId = parseInt(id || "0", 10);

const promo = await apiFetch<{
  id: number;
  title: string;
  description: string;
  type: string;
  bonusAmount: string;
  wagerRequirement: number | null;
  expiresAt: string;
  imageUrl: string;
}>(`/api/promotions/${promoId}`);

const isExpired = promo ? isPromotionExpired(promo.expiresAt) : false;
---

<BaseLayout title={promo ? `${promo.title} — Charter & Oak` : "Promotion Not Found — Charter & Oak"} description={promo?.description || "Promotion details and terms."}>
  <main id="main-content" class="container mx-auto px-4 py-12 flex flex-col gap-8 max-w-4xl">
    {promo ? (
      <>
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <a href="/promotions" class="hover:text-foreground transition-colors">Promotions</a>
          <span>/</span>
          <span class="text-foreground font-medium">{promo.title}</span>
        </div>

        <div class="relative aspect-[21/9] w-full rounded-2xl overflow-hidden bg-card border border-border group">
          {promo.imageUrl ? (
            <img src={promo.imageUrl} alt={promo.title} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-card to-background flex items-center justify-center">
              <span class="text-6xl font-bold text-foreground/5 uppercase tracking-widest">{promo.type}</span>
            </div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent" />

          <div class="absolute bottom-0 left-0 w-full p-8 md:p-12">
            <span class="inline-flex items-center rounded-full bg-primary/20 text-primary border border-primary/30 mb-4 px-3 py-1 font-bold tracking-wider">{promo.type.toUpperCase()}</span>
            <h1 class="text-4xl md:text-6xl text-foreground mb-2 leading-tight">{promo.title}</h1>
            <p class="text-3xl font-black text-primary drop-amber-glow-sm">{promo.bonusAmount}</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mt-4">
          <div class="md:col-span-2 flex flex-col gap-8">
            <div class="prose prose-invert max-w-none">
              <h2 class="text-2xl text-foreground mb-4">Offer Details</h2>
              <p class="text-lg text-muted-foreground leading-relaxed mb-6">{promo.description}</p>

              <h3 class="text-xl text-foreground mb-4">How to Claim</h3>
              <ol class="space-y-2 text-muted-foreground ml-4 list-decimal marker:text-primary marker:font-bold">
                <li>Log in to your Charter &amp; Oak account.</li>
                <li>Opt-in to this promotion via the cashier page.</li>
                <li>Make a qualifying deposit if required.</li>
                <li>Your bonus will be credited automatically.</li>
              </ol>
            </div>
          </div>

          <div class="md:col-span-1">
            <div class="bg-card border border-border rounded-xl p-6 sticky top-24 flex flex-col gap-6">
              <button
                type="button"
                class="w-full btn btn-primary text-lg h-14 amber-glow-sm"
                disabled={isExpired}
              >
                {isExpired ? "Offer Expired" : "Claim Offer"}
              </button>

              <div class="space-y-4 pt-4 border-t border-border">
                {promo.wagerRequirement && (
                  <div>
                    <span class="block text-xs text-muted-foreground uppercase tracking-wider mb-1">Wagering Requirement</span>
                    <span class="block text-lg font-bold text-foreground">{promo.wagerRequirement}x</span>
                  </div>
                )}

                <div>
                  <span class="block text-xs text-muted-foreground uppercase tracking-wider mb-1">Expires</span>
                  <span class={`block text-lg font-bold ${isExpired ? 'text-destructive' : 'text-white'}`}>
                    {new Date(promo.expiresAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
                  </span>
                </div>
              </div>

              <div class="text-xs text-muted-foreground pt-4 border-t border-border">
                <p>Terms and conditions apply. Must be 21+ and physically present in OH. Gambling problem? Call 1-800-589-9966.</p>
              </div>
            </div>
          </div>
        </div>
      </>
    ) : (
      <div class="text-center py-32 flex flex-col items-center justify-center">
        <h2 class="text-2xl text-foreground mb-4">Promotion Not Found</h2>
        <p class="text-muted-foreground mb-8">This offer may have expired or doesn't exist.</p>
        <a href="/promotions" class="btn btn-primary">View All Promotions</a>
      </div>
    )}
  </main>
</BaseLayout>
