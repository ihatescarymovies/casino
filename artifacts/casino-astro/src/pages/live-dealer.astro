---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface DealerTable {
  name: string;
  gradient: string;
  limits: string;
  players: number;
}

const dealerTables: DealerTable[] = [
  {
    name: "Blackjack Live",
    gradient: "from-emerald-900/80 via-emerald-800/60 to-teal-900/80",
    limits: "$25 - $10,000",
    players: 142,
  },
  {
    name: "Roulette Royale",
    gradient: "from-amber-900/80 via-amber-800/60 to-orange-900/80",
    limits: "$10 - $5,000",
    players: 89,
  },
  {
    name: "Baccarat Prestige",
    gradient: "from-emerald-900/80 via-emerald-800/60 to-green-950/80",
    limits: "$50 - $25,000",
    players: 67,
  },
  {
    name: "Poker Arena",
    gradient: "from-amber-950/80 via-amber-900/60 to-orange-950/80",
    limits: "$100 - $50,000",
    players: 203,
  },
  {
    name: "Craps Live",
    gradient: "from-green-900/80 via-emerald-800/60 to-teal-950/80",
    limits: "$5 - $2,500",
    players: 45,
  },
  {
    name: "Sic Bo Deluxe",
    gradient: "from-yellow-900/80 via-amber-800/60 to-orange-900/80",
    limits: "$10 - $1,000",
    players: 31,
  },
];
---

<BaseLayout
  title="Live Dealer — Charter & Oak"
  description="Experience real-time casino action with professional live dealers. Blackjack, roulette, baccarat, and more."
>
  <main id="main-content" class="container mx-auto px-4 py12 flex flex-col gap-12">
    {/* Hero */}
    <div class="text-center max-w-3xl mx-auto mb-8">
      <h1 class="text-4xl md:text-5xl text-foreground mb-6 tracking-tight">
        Live Dealer Experience
      </h1>
      <p class="text-xl text-muted-foreground">
        Step into the action with real dealers, real tables, and real-time gameplay.
        Streamed in HD from our state-of-the-art studios.
      </p>
    </div>

    {/* Dealer Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {dealerTables.map((table) => (
        <div
          class="relative overflow-hidden rounded-2xl border border-border bg-card/50 backdrop-blur-xl transition-all duration-300 hover:border-primary/30 hover:shadow-lg group"
        >
          {/* Gradient background */}
          <div class={`absolute inset-0 bg-gradient-to-br ${table.gradient} opacity-40`} />

          {/* Content */}
          <div class="relative z-10 p-6 flex flex-col gap-4">
            {/* Header */}
            <div class="flex items-start justify-between">
              <h3 class="text-xl text-foreground">{table.name}</h3>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-500/20 border border-red-500/30 text-xs font-semibold text-red-400">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75" />
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500" />
                </span>
                LIVE NOW
              </span>
            </div>

            {/* Stats */}
            <div class="flex items-center gap-4 text-sm text-muted-foreground">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {table.limits}
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                {table.players} playing
              </span>
            </div>

            {/* Action */}
            <button class="btn btn-primary w-full mt-2">
              Join Table
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>
  </main>
</BaseLayout>
