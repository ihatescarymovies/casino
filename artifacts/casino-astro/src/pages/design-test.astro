---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Design System QA — Charter & Oak">
  <main id="main-content" class="min-h-screen py-12 px-6">
    <div class="max-w-6xl mx-auto space-y-16">

      <!-- Header -->
      <header class="text-center space-y-4">
        <h1 class="text-gradient-gold">Charter & Oak</h1>
        <p class="text-muted-foreground text-lg">Design System QA — Phase 3</p>
      </header>

      <!-- Typography Scale -->
      <section class="space-y-6">
        <h2 class="text-primary border-b border-border pb-2">Typography Scale</h2>
        <div class="space-y-4">
          <h1>h1 — The Quick Brown Fox (3rem / 900)</h1>
          <h2>h2 — The Quick Brown Fox (2.25rem / 700)</h2>
          <h3>h3 — The Quick Brown Fox (1.5rem / 700)</h3>
          <h4>h4 — The Quick Brown Fox (1.25rem / 700)</h4>
          <h5>h5 — The Quick Brown Fox (1.125rem / 700)</h5>
          <h6>h6 — The Quick Brown Fox (1rem / 700)</h6>
          <p class="text-muted-foreground">Body text — Inter at 1rem with 1.6 line-height. The casino experience should feel premium and readable across all devices.</p>
        </div>
      </section>

      <!-- Color Swatches -->
      <section class="space-y-6">
        <h2 class="text-primary border-b border-border pb-2">Color Tokens</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="space-y-2">
            <div class="h-16 rounded-lg" style="background: oklch(0.75 0.16 85)"></div>
            <p class="text-sm text-muted-foreground">Primary</p>
          </div>
          <div class="space-y-2">
            <div class="h-16 rounded-lg" style="background: oklch(0.68 0.16 85)"></div>
            <p class="text-sm text-muted-foreground">Primary Hover</p>
          </div>
          <div class="space-y-2">
            <div class="h-16 rounded-lg" style="background: oklch(0.58 0.16 85)"></div>
            <p class="text-sm text-muted-foreground">Primary Pressed</p>
          </div>
          <div class="space-y-2">
            <div class="h-16 rounded-lg" style="background: oklch(0.45 0.12 50)"></div>
            <p class="text-sm text-muted-foreground">Accent Dark</p>
          </div>
          <div class="space-y-2">
            <div class="h-16 rounded-lg" style="background: oklch(0.12 0.01 260)"></div>
            <p class="text-sm text-muted-foreground">Background</p>
          </div>
          <div class="space-y-2">
            <div class="h-16 rounded-lg" style="background: oklch(0.16 0.01 260)"></div>
            <p class="text-sm text-muted-foreground">Card</p>
          </div>
          <div class="space-y-2">
            <div class="h-16 rounded-lg" style="background: oklch(0.65 0.18 145)"></div>
            <p class="text-sm text-muted-foreground">Success</p>
          </div>
          <div class="space-y-2">
            <div class="h-16 rounded-lg" style="background: oklch(0.75 0.15 85)"></div>
            <p class="text-sm text-muted-foreground">Warning</p>
          </div>
        </div>
      </section>

      <!-- Buttons -->
      <section class="space-y-6">
        <h2 class="text-primary border-b border-border pb-2">Buttons</h2>
        <div class="flex flex-wrap gap-4">
          <button class="btn btn-primary">Primary</button>
          <button class="btn btn-secondary">Secondary</button>
          <button class="btn btn-ghost">Ghost</button>
          <button class="btn btn-destructive">Destructive</button>
        </div>
        <div class="flex flex-wrap gap-4">
          <button class="btn btn-primary" disabled>Primary Disabled</button>
          <button class="btn btn-secondary" disabled>Secondary Disabled</button>
          <button class="btn btn-ghost" disabled>Ghost Disabled</button>
          <button class="btn btn-destructive" disabled>Destructive Disabled</button>
        </div>
      </section>

      <!-- Glassmorphism -->
      <section class="space-y-6">
        <h2 class="text-primary border-b border-border pb-2">Glassmorphism</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="glass p-8 rounded-xl">
            <h3 class="text-primary mb-2">Glass Panel</h3>
            <p class="text-muted-foreground">Standard glass effect with 16px blur and subtle border.</p>
          </div>
          <div class="glass-strong p-8 rounded-xl">
            <h3 class="text-primary mb-2">Glass Strong</h3>
            <p class="text-muted-foreground">Stronger glass with 24px blur and increased opacity.</p>
          </div>
        </div>
      </section>

      <!-- Cards -->
      <section class="space-y-6">
        <h2 class="text-primary border-b border-border pb-2">Cards</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="casino-card p-6">
            <h4 class="text-primary mb-2">Standard Card</h4>
            <p class="text-muted-foreground text-sm">Hover to see border glow and shadow lift.</p>
          </div>
          <a href="#" class="block">
            <div class="casino-card p-6">
              <h4 class="text-primary mb-2">Interactive Card</h4>
              <p class="text-muted-foreground text-sm">Focus-visible triggers border-primary.</p>
            </div>
          </a>
          <div class="casino-card p-6">
            <h4 class="text-primary mb-2">Focus Within</h4>
            <p class="text-muted-foreground text-sm">Tab into this card to see focus ring.</p>
          </div>
        </div>
      </section>

      <!-- Animations -->
      <section class="space-y-6">
        <h2 class="text-primary border-b border-border pb-2">Micro-Interactions</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="space-y-3">
            <div class="h-16 rounded-lg animate-shimmer overflow-hidden"></div>
            <p class="text-sm text-muted-foreground text-center">Shimmer</p>
          </div>
          <div class="space-y-3 flex flex-col items-center">
            <div class="h-16 w-16 rounded-full bg-primary animate-pulse-glow flex items-center justify-center">
              <span class="text-primary-foreground font-bold text-xl">$</span>
            </div>
            <p class="text-sm text-muted-foreground text-center">Pulse Glow</p>
          </div>
          <div class="space-y-3 flex flex-col items-center">
            <div class="h-16 w-16 rounded-lg bg-secondary overflow-hidden relative">
              <div class="absolute inset-0 flex items-center justify-center animate-slot-spin">
                <div class="space-y-2">
                  <div class="text-2xl text-primary">7</div>
                  <div class="text-2xl text-destructive">BAR</div>
                </div>
              </div>
            </div>
            <p class="text-sm text-muted-foreground text-center">Slot Spin</p>
          </div>
        </div>
      </section>

      <!-- Focus-Visible Demo -->
      <section class="space-y-6">
        <h2 class="text-primary border-b border-border pb-2">Focus-Visible (Keyboard Navigation)</h2>
        <p class="text-muted-foreground">Tab through these buttons to see the focus-visible ring in action.</p>
        <div class="flex flex-wrap gap-4">
          <button class="btn btn-primary">Tab to Focus 1</button>
          <button class="btn btn-secondary">Tab to Focus 2</button>
          <button class="btn btn-ghost">Tab to Focus 3</button>
          <button class="btn btn-destructive">Tab to Focus 4</button>
        </div>
      </section>

      <!-- Dark Mode Confirmation -->
      <section class="space-y-6">
        <h2 class="text-primary border-b border-border pb-2">Dark Mode</h2>
        <p class="text-muted-foreground">This page is rendered in dark mode by default. The <code class="bg-muted px-1 py-0.5 rounded text-sm">.dark</code> class is applied to the <code class="bg-muted px-1 py-0.5 rounded text-sm">&lt;html&gt;</code> element.</p>
        <div class="glass p-6 rounded-xl">
          <p class="text-foreground">Background should be very dark navy. Cards are slightly lighter. Gold primary pops against the dark canvas.</p>
        </div>
      </section>

    </div>
  </main>
</BaseLayout>
