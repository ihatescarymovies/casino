---
import BaseLayout from "@/layouts/BaseLayout.astro";

const returnTo = Astro.url.searchParams.get("returnTo") || "/";
---

<BaseLayout
  title="Sign Up — Charter & Oak"
  description="Create your Charter & Oak Casino account and start playing."
>
  <section class="relative min-h-[85vh] flex flex-col items-center justify-center overflow-hidden">
    {/* Amber lamplight */}
    <div class="absolute inset-0 amber-lamp"></div>
    {/* Felt surface */}
    <div class="absolute inset-0 felt-surface opacity-25"></div>

    <div class="container mx-auto px-4 z-10 flex flex-col items-center">
      <div class="w-full max-w-md flex flex-col gap-8 rounded-xl bg-card border border-border shadow-lg p-8 md:p-10">
        {/* Brand mark */}
        <div class="flex flex-col items-center gap-3">
          <span class="text-xl caslon tracking-tight text-primary">Charter &amp; Oak</span>
          <div class="h-px w-12 bg-primary/30"></div>
        </div>

        <div class="flex flex-col gap-2 text-center">
          <h1 class="text-3xl text-foreground">Join the Table</h1>
          <p class="text-muted-foreground text-sm">
            Create your account and start playing today.
          </p>
        </div>

        {/* Feature bullets — brass checkmarks */}
        <div class="flex flex-col gap-3">
          {[
            "200+ premium slots and table games",
            "Live dealer tables with real croupiers",
            "Progressive jackpots with massive payouts",
            "Secure deposits and instant withdrawals",
          ].map((feature) => (
            <div class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-primary/15 text-primary shrink-0">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <span class="text-sm text-muted-foreground">{feature}</span>
            </div>
          ))}
        </div>

        <a
          href={`/api/login?returnTo=${encodeURIComponent(returnTo)}`}
          class="btn btn-primary w-full text-base py-3 amber-glow-sm"
        >
          Create Account
        </a>

        <p class="text-sm text-muted-foreground text-center">
          Already have an account?
          <a
            href={`/login?returnTo=${encodeURIComponent(returnTo)}`}
            class="text-primary hover:underline ml-1">Log in</a
          >
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
