---
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Charter & Oak — Premium Online Casino",
  description = "Experience world-class gaming at Charter & Oak Casino. Slots, table games, live dealers, and more.",
  image = "/og-image.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:4321");
const currentPath = Astro.url.pathname;
const user = Astro.locals.user as {
  firstName?: string;
  lastName?: string;
  email?: string;
  profileImageUrl?: string;
} | null;
const isAuthenticated = !!user;

import "@/styles/global.css"
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteHeader currentPath={currentPath} user={user} isAuthenticated={isAuthenticated} />
    <main id="main-content" aria-label="Main content" class="flex-1 w-full flex flex-col">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
