---
import { getGameFallbackImage } from "@/lib/game-helpers";

interface Props {
  id: number;
  name: string;
  category: string;
  provider: string;
  imageUrl?: string;
  isFeatured?: boolean;
  isHot?: boolean;
  isNew?: boolean;
}

const { id, name, category, provider, imageUrl, isFeatured, isHot, isNew } = Astro.props;

const image = imageUrl || getGameFallbackImage(category);
---

<div class="group block">
  <div class="casino-card relative overflow-hidden transition-all duration-300 hover:scale-[1.02] cursor-pointer">
    <div class="aspect-[4/3] w-full overflow-hidden relative">
      <img
        src={image}
        alt={name}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />

      {/* Badges — brass, not neon */}
      <div class="absolute top-3 right-3 flex flex-col gap-2">
        {isHot && (
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-destructive text-destructive-foreground">
            HOT
          </span>
        )}
        {isNew && (
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-primary/90 text-primary-foreground">
            NEW
          </span>
        )}
        {isFeatured && (
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-primary text-primary-foreground">
            FEATURED
          </span>
        )}
      </div>

      {/* Card info — like the text on a playing card */}
      <div class="absolute bottom-0 left-0 w-full p-4 transform translate-y-2 group-hover:translate-y-0 transition-transform">
        <p class="text-xs font-semibold text-primary mb-1 uppercase tracking-wider">{category}</p>
        <h3 class="text-lg text-foreground leading-tight truncate">{name}</h3>
        <p class="text-xs text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity delay-100">{provider}</p>
      </div>

      {/* Hover overlay — brass buttons */}
      <div class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 bg-background/60 gap-3">
        <a href={`/games/${id}?mode=real`} class="btn btn-primary text-sm">
          Play Now
        </a>
        <a href={`/games/${id}?mode=demo`} class="btn btn-secondary text-sm">
          Free Play
        </a>
      </div>
    </div>
  </div>
</div>
