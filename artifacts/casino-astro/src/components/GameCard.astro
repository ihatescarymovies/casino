---
import { getGameFallbackImage } from "@/lib/game-helpers";

interface Props {
  id: number;
  name: string;
  category: string;
  provider: string;
  imageUrl?: string;
  isFeatured?: boolean;
  isHot?: boolean;
  isNew?: boolean;
}

const { id, name, category, provider, imageUrl, isFeatured, isHot, isNew } = Astro.props;

const image = imageUrl || getGameFallbackImage(category);
---

<a href={`/games/${id}`} class="group block">
  <div class="casino-card relative overflow-hidden transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_30px_rgba(234,179,8,0.15)] hover:border-primary/50 cursor-pointer">
    <div class="aspect-[4/3] w-full overflow-hidden relative">
      <img
        src={image}
        alt={name}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity" />

      <div class="absolute top-3 right-3 flex flex-col gap-2">
        {isHot && (
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-destructive text-destructive-foreground shadow-[0_0_10px_rgba(220,38,38,0.8)] border-none">
            HOT
          </span>
        )}
        {isNew && (
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-blue-500 text-white shadow-[0_0_10px_rgba(59,130,246,0.8)] border-none">
            NEW
          </span>
        )}
        {isFeatured && (
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-primary text-primary-foreground shadow-[0_0_10px_rgba(234,179,8,0.8)] border-none">
            FEATURED
          </span>
        )}
      </div>

      <div class="absolute bottom-0 left-0 w-full p-4 transform translate-y-2 group-hover:translate-y-0 transition-transform">
        <p class="text-xs font-semibold text-primary mb-1 uppercase tracking-wider">{category}</p>
        <h3 class="text-lg font-bold text-white leading-tight truncate">{name}</h3>
        <p class="text-xs text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity delay-100">{provider}</p>
      </div>

      <div class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 bg-black/40 backdrop-blur-[2px] gap-3">
        <a href={`/games/${id}?mode=real`} class="bg-primary text-primary-foreground font-bold px-6 py-2 rounded-full transform scale-90 group-hover:scale-100 transition-transform duration-300 shadow-[0_0_20px_rgba(234,179,8,0.6)] text-sm">
          PLAY NOW
        </a>
        <a href={`/games/${id}?mode=demo`} class="bg-white/10 text-white font-bold px-6 py-2 rounded-full transform scale-90 group-hover:scale-100 transition-transform duration-300 border border-white/20 hover:bg-white/20 text-sm">
          FREE PLAY
        </a>
      </div>
    </div>
  </div>
</a>
