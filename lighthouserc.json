{
  "ci": {
    "collect": {
      "startServerCommand": "cd artifacts/casino-astro && pnpm run preview",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/games",
        "http://localhost:4321/promotions"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
        "errors-in-console": ["warn", { "minScore": 0 }],
        "lcp-discovery-insight": ["warn", { "minScore": 0 }],
        "network-dependency-tree-insight": ["warn", { "minScore": 0 }],
        "prioritize-lcp-image": ["warn", { "minScore": 0 }],
        "uses-text-compression": ["warn", { "minScore": 0 }],
        "unused-javascript": ["warn", { "minScore": 0 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
