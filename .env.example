# API Server
PORT=3000

# PostgreSQL (existing)
DATABASE_URL=postgresql://user:password@localhost:5432/casino

# PayRam — obtained after running setup_payram.sh on the VPS
# PAYRAM_API_URL: your PayRam instance base URL
PAYRAM_API_URL=https://your-payram-instance.example.com

# JWT access token from ~/.payraminfo/headless-tokens.env (ACCESS_TOKEN field)
# Note: this token expires ~30 days after creation and must be refreshed
PAYRAM_API_KEY=your-payram-jwt-access-token

# Numeric project ID from PayRam dashboard or API (/api/v1/external-platform/details)
PAYRAM_PROJECT_ID=1
