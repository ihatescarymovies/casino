# API Server
PORT=3000

# CORS — comma-separated list of allowed origins.
# Defaults to http://localhost:4321, http://localhost:3000, https://casino.timewarper.me
# ALLOWED_ORIGINS=https://casino.timewarper.me,http://localhost:4321

# PostgreSQL (existing)
DATABASE_URL=postgresql://user:password@localhost:5432/casino

# PayRam — obtained after running setup_payram.sh on the VPS
# PAYRAM_API_URL: base URL of your PayRam instance (from provisioning / dashboard)
PAYRAM_API_URL=https://your-payram-instance.example.com

# Merchant API key from PayRam dashboard. Used for both API authentication
# and webhook verification (SDK verifyApiKey checks the API-Key header).
PAYRAM_API_KEY=your-payram-api-key

# Numeric project ID from PayRam dashboard or API (/api/v1/external-platform/details)
PAYRAM_PROJECT_ID=1
