/.sass-cache
/connect.lock
/libpeerconnection.log
/typings

# ── Logs ────────────────────────────────────────────────────────────
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*
testem.log
*.log

# ── System files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pid

# ── Replit ──────────────────────────────────────────────────────────
.cache/
.local/
.replit
.replitignore
replit.md
**/.replit-artifact/

# ── OpenCode / oh-my-openagent (legacy) ─────────────────────────────
