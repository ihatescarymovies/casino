dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared
.astro
.vercel

# ── Dependencies ────────────────────────────────────────────────────
node_modules
.pnpm-store

# ── Test artifacts ──────────────────────────────────────────────────
coverage
test-results
playwright-report
playwright/.cache
.nyc_output

# ── IDEs and editors ────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
*~

# ── IDE — VSCode ────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── AI / agent tool state ───────────────────────────────────────────
.omc/
.opencode/
.tokensave/
.foresight/
.jcode/
.claude/
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

